# Postgres — created by scripts/dev_db.sh
DATABASE_URL=postgresql+psycopg://localhost/mazz_dev

# Review app session signing key. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=changeme
# Logins are per person and live in the database, not here:
#   python -m mazz.users seed-launch
#   python -m mazz.users set-password maaz@clientrise.io

# Postal address for the footer is set PER WORKSPACE on /campaigns and must be
# confirmed by a named person before any email uses it. This env var is only
# the fallback for paths with no workspace (seed/demo scripts).
SENDER_POSTAL_ADDRESS=

# THE kill switch. false (default) writes each released message's MIME to
# out/dryrun/ and sends nothing, whatever EMAIL_SENDER says. Only the go-live
# gate sets it true.
SEND_ENABLED=false
# Public base URL that serves /u/<token>. Must be https before anything sends.
UNSUBSCRIBE_BASE_URL=https://outreach.getsearchsitemarketing.com
# Requests on this host may reach /u/* and /health only. Blank = single host
# (dev only: live sending refuses to boot unless it equals UNSUBSCRIBE_BASE_URL's host).
UNSUBSCRIBE_HOST=
# Keys the unsubscribe token in every footer. Set once (32+ chars), never
# rotate: a new value kills every link already in someone's inbox. Blank falls
# back to SESSION_SECRET; live sending requires it.
UNSUBSCRIBE_SECRET=

# --- Phase 2. Unused in Phase 1; every provider is fixture-stubbed. ---
ANTHROPIC_API_KEY=

# --- Drafting ---------------------------------------------------------
# "template" (default) is the deterministic Phase 1 composer: no key, no
# network, reproducible. "claude" switches on the real model call and starts
# spending. A key alone never does that -- this setting does.
DRAFT_COMPOSER=template
# Blank means claude-opus-5. Change it only behind a measured eval, and check
# `compose_claude.MIN_CACHEABLE_PREFIX_TOKENS` first: a cheaper model can have
# a LONGER minimum cacheable prefix, so a downgrade can silently lose prompt
# caching and cost more than it saves.
DRAFT_MODEL=
# Blank means the API default (`high`) -- no quality trade out of the box.
# This is the first cost lever to sweep once an eval set exists.
DRAFT_EFFORT=
# Requests per Batch API submission. API ceiling is 100,000.
DRAFT_BATCH_SIZE=500

LINKEDIN_PROVIDER=stub
# Bright Data account key. Leave LINKEDIN_PROVIDER=stub even if this is set --
# the provider name, not key presence, decides which adapter loads.
LINKEDIN_API_KEY=

# --- Sending ----------------------------------------------------------
# "stub" (default) appends the real MIME to `sent_outbox.jsonl` and touches no
# network. "google" sends as the client's own Google Workspace mailboxes over
# the Gmail API. A service-account key alone never flips this -- this setting
# does, and nothing else. Install the extra first: pip install -e '.[google]'
EMAIL_SENDER=stub
# Per-mailbox defaults, used when a mailboxes row does not set its own.
# Small on purpose: Workspace permits ~2000/day, cold outreach from a burner
# domain does not survive anything close to that.
DEFAULT_DAILY_CAP=15
DEFAULT_MIN_SPACING_SECONDS=300
# --- Google OAuth (per-mailbox; replaces the service account) ---------
# Created once by the operator in Google Cloud: scopes gmail.send and
# gmail.readonly, publishing status "In production" (a "Testing" app issues
# refresh tokens that expire after 7 days). Authorised redirect URI:
#   <APP_BASE_URL>/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public https base URL of THIS app (not the unsubscribe host).
APP_BASE_URL=
# Fernet key encrypting each mailbox's refresh token in the database. Generate:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Lose it and every mailbox must be reconnected. Never commit it.
OAUTH_TOKEN_KEY=
