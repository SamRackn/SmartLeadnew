# Postgres — created by scripts/dev_db.sh
DATABASE_URL=postgresql+psycopg://localhost/mazz_dev

# Review app session signing key. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=changeme
# Single reviewer login. Hash: python -m mazz.web.auth hash <password>
REVIEW_USER=client
REVIEW_PASSWORD_HASH=

# Physical mailing address for the CAN-SPAM footer. Required — drafts will not
# render without it.
SENDER_POSTAL_ADDRESS=

# --- Phase 2. Unused in Phase 1; every provider is fixture-stubbed. ---
SMARTLEAD_API_KEY=
SMARTLEAD_DEFAULT_CAMPAIGN_ID=
ANTHROPIC_API_KEY=

# --- Drafting ---------------------------------------------------------
# "template" (default) is the deterministic Phase 1 composer: no key, no
# network, reproducible. "claude" switches on the real model call and starts
# spending. A key alone never does that -- this setting does.
DRAFT_COMPOSER=template
# Blank means claude-opus-5. Change it only behind a measured eval, and check
# `compose_claude.MIN_CACHEABLE_PREFIX_TOKENS` first: a cheaper model can have
# a LONGER minimum cacheable prefix, so a downgrade can silently lose prompt
# caching and cost more than it saves.
DRAFT_MODEL=
# Blank means the API default (`high`) -- no quality trade out of the box.
# This is the first cost lever to sweep once an eval set exists.
DRAFT_EFFORT=
# Requests per Batch API submission. API ceiling is 100,000.
DRAFT_BATCH_SIZE=500

LINKEDIN_PROVIDER=stub
# Bright Data account key. Leave LINKEDIN_PROVIDER=stub even if this is set --
# the provider name, not key presence, decides which adapter loads.
LINKEDIN_API_KEY=
